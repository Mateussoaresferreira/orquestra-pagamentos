{
  "openapi": "3.1.0",
  "info": {
    "title": "API da Razão Contábil | Orquestra de Pagamentos",
    "description": "Partidas dobradas, recebíveis e administração das filas contábeis.",
    "version": "1.0.0",
    "license": {
      "name": "MIT",
      "url": "https://github.com/Mateussoaresferreira/orquestra-pagamentos/blob/main/LICENSE"
    }
  },
  "paths": {
    "/api/v1/admin/quarentena/{idEvento}/reprocessar": {
      "post": {
        "tags": [
          "controlador-quarentena"
        ],
        "operationId": "reprocessar",
        "parameters": [
          {
            "name": "X-Empresa-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "idEvento",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PedidoTratamentoQuarentena"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Credenciais ausentes ou inválidas"
          },
          "403": {
            "description": "Escopo ou empresa não autorizados"
          }
        },
        "summary": "Reprocessa um evento em quarentena de forma auditável"
      }
    },
    "/api/v1/admin/quarentena/{idEvento}/descartar": {
      "post": {
        "tags": [
          "controlador-quarentena"
        ],
        "operationId": "descartarDefinitivamente",
        "parameters": [
          {
            "name": "X-Empresa-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "idEvento",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PedidoTratamentoQuarentena"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Credenciais ausentes ou inválidas"
          },
          "403": {
            "description": "Escopo ou empresa não autorizados"
          }
        },
        "summary": "Descarta definitivamente um evento em quarentena"
      }
    },
    "/api/v1/transacoes-contabeis/compras/{idCompra}/parcelas/{numero}/liquidacao": {
      "patch": {
        "tags": [
          "controlador-razao"
        ],
        "summary": "Liquida uma parcela de forma idempotente e auditavel",
        "operationId": "liquidar",
        "parameters": [
          {
            "name": "X-Empresa-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "idCompra",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "numero",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "maximum": 12,
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LiquidacaoParcela"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ParcelaRecebivel"
                }
              }
            }
          },
          "401": {
            "description": "Credenciais ausentes ou inválidas"
          },
          "403": {
            "description": "Escopo ou empresa não autorizados"
          }
        }
      }
    },
    "/api/v1/transacoes-contabeis/compras/{idCompra}": {
      "get": {
        "tags": [
          "controlador-razao"
        ],
        "summary": "Consulta a transacao e suas partidas imutaveis",
        "operationId": "buscar",
        "parameters": [
          {
            "name": "X-Empresa-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "idCompra",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaTransacaoContabil"
                }
              }
            }
          },
          "401": {
            "description": "Credenciais ausentes ou inválidas"
          },
          "403": {
            "description": "Escopo ou empresa não autorizados"
          }
        }
      }
    },
    "/api/v1/admin/quarentena": {
      "get": {
        "tags": [
          "controlador-quarentena"
        ],
        "operationId": "listar",
        "parameters": [
          {
            "name": "X-Empresa-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "ATIVA"
            }
          },
          {
            "name": "pagina",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0
            }
          },
          {
            "name": "tamanho",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PaginaQuarentena"
                }
              }
            }
          },
          "401": {
            "description": "Credenciais ausentes ou inválidas"
          },
          "403": {
            "description": "Escopo ou empresa não autorizados"
          }
        },
        "summary": "Lista eventos em quarentena com paginação e filtro de status"
      }
    },
    "/api/v1/admin/quarentena/{idEvento}/auditoria": {
      "get": {
        "tags": [
          "controlador-quarentena"
        ],
        "operationId": "listarAuditoria",
        "parameters": [
          {
            "name": "X-Empresa-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "idEvento",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AuditoriaQuarentena"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Credenciais ausentes ou inválidas"
          },
          "403": {
            "description": "Escopo ou empresa não autorizados"
          }
        },
        "summary": "Lista o histórico de tratamento de um evento em quarentena"
      }
    }
  },
  "components": {
    "schemas": {
      "PedidoTratamentoQuarentena": {
        "type": "object",
        "properties": {
          "motivo": {
            "type": "string"
          }
        }
      },
      "LiquidacaoParcela": {
        "type": "object",
        "properties": {
          "referencia": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          }
        },
        "required": [
          "referencia"
        ]
      },
      "ParcelaRecebivel": {
        "type": "object",
        "properties": {
          "idParcela": {
            "type": "string",
            "format": "uuid"
          },
          "numero": {
            "type": "integer",
            "format": "int32"
          },
          "totalParcelas": {
            "type": "integer",
            "format": "int32"
          },
          "valor": {
            "type": "number"
          },
          "vencimento": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "type": "string"
          },
          "referenciaLiquidacao": {
            "type": "string"
          },
          "criadaEm": {
            "type": "string",
            "format": "date-time"
          },
          "liquidadaEm": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Lancamento": {
        "type": "object",
        "properties": {
          "idLancamento": {
            "type": "string",
            "format": "uuid"
          },
          "conta": {
            "type": "string"
          },
          "natureza": {
            "type": "string"
          },
          "valor": {
            "type": "number"
          },
          "moeda": {
            "type": "string"
          },
          "criadoEm": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RespostaTransacaoContabil": {
        "type": "object",
        "properties": {
          "idTransacao": {
            "type": "string",
            "format": "uuid"
          },
          "idCompra": {
            "type": "string",
            "format": "uuid"
          },
          "idPagamento": {
            "type": "string",
            "format": "uuid"
          },
          "valor": {
            "type": "number"
          },
          "moeda": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "motivo": {
            "type": "string"
          },
          "criadaEm": {
            "type": "string",
            "format": "date-time"
          },
          "totalDebitos": {
            "type": "number"
          },
          "totalCreditos": {
            "type": "number"
          },
          "lancamentos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Lancamento"
            }
          },
          "parcelas": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ParcelaRecebivel"
            }
          }
        }
      },
      "EventoQuarentena": {
        "type": "object",
        "properties": {
          "idEvento": {
            "type": "string",
            "format": "uuid"
          },
          "tipo": {
            "type": "string"
          },
          "versao": {
            "type": "integer",
            "format": "int32"
          },
          "idCorrelacao": {
            "type": "string",
            "format": "uuid"
          },
          "idCompra": {
            "type": "string",
            "format": "uuid"
          },
          "origem": {
            "type": "string"
          },
          "tentativas": {
            "type": "integer",
            "format": "int32"
          },
          "reprocessamentos": {
            "type": "integer",
            "format": "int32"
          },
          "ultimoErro": {
            "type": "string"
          },
          "ocorridoEm": {
            "type": "string",
            "format": "date-time"
          },
          "descartadoEm": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string"
          },
          "resolvidoEm": {
            "type": "string",
            "format": "date-time"
          },
          "motivoResolucao": {
            "type": "string"
          }
        }
      },
      "PaginaQuarentena": {
        "type": "object",
        "properties": {
          "itens": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventoQuarentena"
            }
          },
          "pagina": {
            "type": "integer",
            "format": "int32"
          },
          "tamanho": {
            "type": "integer",
            "format": "int32"
          },
          "total": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "AuditoriaQuarentena": {
        "type": "object",
        "properties": {
          "idAuditoria": {
            "type": "string",
            "format": "uuid"
          },
          "acao": {
            "type": "string"
          },
          "responsavel": {
            "type": "string"
          },
          "detalhes": {
            "type": "string"
          },
          "tentativasAnteriores": {
            "type": "integer",
            "format": "int32"
          },
          "erroAnterior": {
            "type": "string"
          },
          "motivo": {
            "type": "string"
          },
          "registradaEm": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "securitySchemes": {
      "portadorJwt": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token OAuth2 exigido no perfil cloud; o perfil local desabilita autenticação."
      }
    }
  },
  "security": [
    {
      "portadorJwt": []
    }
  ],
  "servers": [
    {
      "url": "http://localhost:8084",
      "description": "Ambiente local"
    }
  ]
}
