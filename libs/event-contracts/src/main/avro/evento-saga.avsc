{
  "type": "record",
  "name": "EventoSaga",
  "namespace": "br.com.orquestrapay.contracts",
  "doc": "Envelope versionado dos comandos e eventos da saga de compra.",
  "fields": [
    {"name": "idEvento", "type": "string"},
    {"name": "tipo", "type": "string"},
    {"name": "versao", "type": "int", "default": 1},
    {"name": "idCorrelacao", "type": "string"},
    {"name": "idEmpresa", "type": "string"},
    {"name": "idCompra", "type": "string"},
    {"name": "origem", "type": "string"},
    {"name": "ocorridoEm", "type": {"type": "long", "logicalType": "timestamp-millis"}},
    {"name": "sequencia", "type": "long"},
    {"name": "conteudo", "type": "string"},
    {"name": "traceparent", "type": ["null", "string"], "default": null}
  ]
}
