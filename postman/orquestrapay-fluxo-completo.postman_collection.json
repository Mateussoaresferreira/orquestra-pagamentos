              "else { const corpo = pm.response.json(); if (corpo.status !== 'AGUARDANDO_CONFIRMACAO' && tentativa < 30) { pm.collectionVariables.set('tentativasPix', String(tentativa)); pm.execution.setNextRequest(pm.info.requestName); } else { pm.collectionVariables.unset('tentativasPix'); pm.test('Cobranca PIX possui BR Code e QR Code', () => { pm.response.to.have.status(200); pm.expect(corpo.status).to.eql('AGUARDANDO_CONFIRMACAO'); pm.expect(corpo.txid).to.be.ok; pm.expect(corpo.copiaColaPix).to.match(/^000201/); pm.expect(corpo.copiaColaPix).to.match(/6304[0-9A-F]{4}$/); pm.expect(corpo.imagemQrCodeBase64).to.be.a('string').and.not.empty; pm.expect(['principal', 'contingencia']).to.include(corpo.provedor); }); pm.collectionVariables.set('txidPix', corpo.txid); const urlProvedor = corpo.provedor === 'contingencia' ? pm.environment.get('urlProvedorContingencia') : pm.environment.get('urlProvedorPrincipal'); pm.collectionVariables.set('urlProvedorPix', urlProvedor); const visualizacao = `<style>body{font-family:Arial,sans-serif;color:#172033;padding:24px}main{max-width:720px;margin:auto}img{display:block;width:320px;height:320px;image-rendering:pixelated;border:1px solid #d5dae3}dt{font-weight:700;margin-top:18px}dd{margin:6px 0;overflow-wrap:anywhere}code{font-size:12px}</style><main><h2>Cobranca PIX gerada</h2><img src=\"data:image/png;base64,{{imagem}}\" alt=\"QR Code PIX\"><dl><dt>TXID</dt><dd><code>{{txid}}</code></dd><dt>PIX Copia e Cola</dt><dd><code>{{copiaCola}}</code></dd></dl></main>`; pm.visualizer.set(visualizacao, { imagem: corpo.imagemQrCodeBase64, txid: corpo.txid, copiaCola: corpo.copiaColaPix }); } }"
            ], "type": "text/javascript" } }
