{
  "info": {
    "_postman_id": "6646ac40-f6e8-4dc9-bb3d-91015ca2bd0f",
    "name": "Orquestra de Pagamentos - Fluxo completo",
    "description": "Valida os fluxos reais de cartao parcelado, fallback entre provedores, PIX assincrono, webhooks HMAC, conciliacao, quarentena e evidencias produzidas pelos microsservicos. O ambiente local funciona sem token. Para seguranca habilitada, preencha tokenAcesso.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{tokenAcesso}}", "type": "string" }]
  },
  "variable": [
    { "key": "idEmpresa", "value": "" },
    { "key": "idProdutoA", "value": "30000000-0000-0000-0000-000000000001" },
    { "key": "idProdutoB", "value": "30000000-0000-0000-0000-000000000002" },
    { "key": "chaveIdempotencia", "value": "" },
    { "key": "idCompra", "value": "" },
    { "key": "idPagamento", "value": "" },
    { "key": "idAutorizacao", "value": "" },
    { "key": "provedorPagamento", "value": "" },
    { "key": "identificadorExtratoConciliacao", "value": "" },
    { "key": "periodoInicioConciliacao", "value": "" },
    { "key": "periodoFimConciliacao", "value": "" },
    { "key": "ocorridoEmConciliacao", "value": "" },
    { "key": "idDivergencia", "value": "" },
    { "key": "idCompraRecusada", "value": "" },
    { "key": "idCompraCompensada", "value": "" },
    { "key": "idCompraFallback", "value": "" },
    { "key": "idCompraPix", "value": "" },
    { "key": "txidPix", "value": "" },
    { "key": "urlProvedorPix", "value": "" },
    { "key": "tentativasSaga", "value": "" },
    { "key": "tentativasNotificacao", "value": "" },
    { "key": "tentativasRecusa", "value": "" },
    { "key": "tentativasCompensacao", "value": "" }
  ],
  "item": [
    {
      "name": "01 - Preparar dados",
      "item": [
        {
          "name": "Definir estoque do produto A",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('idEmpresa', pm.variables.replaceIn('{{$guid}}'));",
                  "pm.collectionVariables.set('chaveIdempotencia', 'postman-' + pm.variables.replaceIn('{{$guid}}'));",
                  "pm.collectionVariables.unset('idCompra');",
                  "pm.collectionVariables.unset('idPagamento');",
                  "pm.collectionVariables.unset('idDivergencia');",
                  "pm.collectionVariables.unset('tentativasSaga');",
                  "pm.collectionVariables.unset('tentativasNotificacao');",
                  "pm.collectionVariables.unset('tentativasRecusa');",
                  "pm.collectionVariables.unset('tentativasCompensacao');"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Estoque A preparado', () => pm.response.to.have.status(200));",
                  "pm.test('Saldo A igual a 100', () => pm.expect(pm.response.json().quantidadeDisponivel).to.eql(100));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "X-Empresa-Id", "value": "{{idEmpresa}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"quantidadeDisponivel\": 100,\n  \"motivo\": \"Preparacao do fluxo Postman\"\n}" },
            "url": { "raw": "{{urlEstoque}}/api/v1/estoques/{{idProdutoA}}", "host": ["{{urlEstoque}}"], "path": ["api", "v1", "estoques", "{{idProdutoA}}"] }
          }
        },
        {
          "name": "Definir estoque do produto B",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Estoque B preparado', () => pm.response.to.have.status(200));"], "type": "text/javascript" } }],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "X-Empresa-Id", "value": "{{idEmpresa}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"quantidadeDisponivel\": 100,\n  \"motivo\": \"Preparacao do fluxo Postman\"\n}" },
            "url": { "raw": "{{urlEstoque}}/api/v1/estoques/{{idProdutoB}}", "host": ["{{urlEstoque}}"], "path": ["api", "v1", "estoques", "{{idProdutoB}}"] }
          }
        },
        {
          "name": "Configurar webhook empresarial",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Webhook configurado sem revelar o segredo', () => { pm.response.to.have.status(200); pm.expect(pm.response.json()).not.to.have.property('segredo'); });"
          ], "type": "text/javascript" } }],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "X-Empresa-Id", "value": "{{idEmpresa}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"url\": \"http://receptor-webhook:8080/orquestrapay\",\n  \"segredo\": \"segredo-webhook-demonstracao-local-2026\",\n  \"eventos\": [\"COMPRA_CONCLUIDA\", \"COMPRA_RECUSADA\", \"COMPRA_COMPENSADA\"],\n  \"ativo\": true\n}" },
            "url": { "raw": "{{urlNotificacao}}/api/v1/webhooks/configuracao", "host": ["{{urlNotificacao}}"], "path": ["api", "v1", "webhooks", "configuracao"] }
          }
        }
      ]
    },
    {
      "name": "02 - Compra aprovada",
      "item": [
        {
          "name": "Criar compra",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Compra aceita de forma assincrona', () => pm.response.to.have.status(202));",
            "const corpo = pm.response.json();",
            "pm.expect(corpo.status).to.eql('RECEBIDA');",
            "pm.collectionVariables.set('idCompra', corpo.idCompra);"
          ], "type": "text/javascript" } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Empresa-Id", "value": "{{idEmpresa}}" },
              { "key": "Idempotency-Key", "value": "{{chaveIdempotencia}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"idCliente\": \"cliente-postman-001\",\n  \"emailCliente\": \"cliente.postman@orquestrapay.local\",\n  \"moeda\": \"BRL\",\n  \"pais\": \"BR\",\n  \"identificadorDispositivo\": \"notebook-postman-001\",\n  \"metodoPagamento\": \"CARTAO\",\n  \"parcelas\": 3,\n  \"tokenPagamento\": \"tok_aprovado\",\n  \"itens\": [\n    { \"idProduto\": \"{{idProdutoA}}\", \"quantidade\": 2, \"precoUnitario\": 79.90 },\n    { \"idProduto\": \"{{idProdutoB}}\", \"quantidade\": 1, \"precoUnitario\": 39.90 }\n  ]\n}" },
            "url": { "raw": "{{urlCheckout}}/api/v1/compras", "host": ["{{urlCheckout}}"], "path": ["api", "v1", "compras"] }
          }
        },
        {
          "name": "Repetir a mesma compra",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Repeticao retorna 202', () => pm.response.to.have.status(202));",
            "pm.test('Servidor marcou replay', () => pm.expect(pm.response.headers.get('Idempotency-Replayed')).to.eql('true'));",
            "pm.test('Nao criou outra compra', () => pm.expect(pm.response.json().idCompra).to.eql(pm.collectionVariables.get('idCompra')));"
          ], "type": "text/javascript" } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Empresa-Id", "value": "{{idEmpresa}}" },
              { "key": "Idempotency-Key", "value": "{{chaveIdempotencia}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"idCliente\": \"cliente-postman-001\",\n  \"emailCliente\": \"cliente.postman@orquestrapay.local\",\n  \"moeda\": \"BRL\",\n  \"pais\": \"BR\",\n  \"identificadorDispositivo\": \"notebook-postman-001\",\n  \"metodoPagamento\": \"CARTAO\",\n  \"parcelas\": 3,\n  \"tokenPagamento\": \"tok_aprovado\",\n  \"itens\": [\n    { \"idProduto\": \"{{idProdutoA}}\", \"quantidade\": 2, \"precoUnitario\": 79.90 },\n    { \"idProduto\": \"{{idProdutoB}}\", \"quantidade\": 1, \"precoUnitario\": 39.90 }\n  ]\n}" },
            "url": { "raw": "{{urlCheckout}}/api/v1/compras", "host": ["{{urlCheckout}}"], "path": ["api", "v1", "compras"] }
          }
        },
        {
          "name": "Consultar estado da compra",
          "event": [
            { "listen": "prerequest", "script": { "exec": [
              "const tentativa = Number(pm.collectionVariables.get('tentativasSaga') || 0);",
              "if (tentativa > 0) { setTimeout(() => {}, 1000); }"
            ], "type": "text/javascript" } },
            { "listen": "test", "script": { "exec": [
              "pm.test('Compra encontrada', () => pm.response.to.have.status(200));",
              "const corpo = pm.response.json();",
              "const tentativa = Number(pm.collectionVariables.get('tentativasSaga') || 0) + 1;",
              "const estadosEmAndamento = ['RECEBIDA','ESTOQUE_RESERVADO','RISCO_APROVADO','PAGAMENTO_AUTORIZADO'];",
              "if (corpo.status !== 'CONCLUIDA' && estadosEmAndamento.includes(corpo.status) && tentativa < 60) {",
              "  pm.collectionVariables.set('tentativasSaga', String(tentativa));",
              "  pm.execution.setNextRequest(pm.info.requestName);",
              "} else {",
              "  pm.collectionVariables.unset('tentativasSaga');",
              "  pm.test('Saga concluida antes do limite', () => pm.expect(corpo.status).to.eql('CONCLUIDA'));",
              "}"
            ], "type": "text/javascript" } }
          ],
          "request": { "method": "GET", "header": [{ "key": "X-Empresa-Id", "value": "{{idEmpresa}}" }], "url": { "raw": "{{urlCheckout}}/api/v1/compras/{{idCompra}}", "host": ["{{urlCheckout}}"], "path": ["api", "v1", "compras", "{{idCompra}}"] } }
        },
        {
          "name": "Consultar historico da saga",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Historico possui etapas', () => pm.expect(pm.response.json().length).to.be.above(0));"], "type": "text/javascript" } }],
          "request": { "method": "GET", "header": [{ "key": "X-Empresa-Id", "value": "{{idEmpresa}}" }], "url": { "raw": "{{urlCheckout}}/api/v1/compras/{{idCompra}}/historico", "host": ["{{urlCheckout}}"], "path": ["api", "v1", "compras", "{{idCompra}}", "historico"] } }
        },
        {
          "name": "Consultar risco",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Risco aprovado', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().aprovada).to.be.true; });"], "type": "text/javascript" } }],
          "request": { "method": "GET", "header": [{ "key": "X-Empresa-Id", "value": "{{idEmpresa}}" }], "url": { "raw": "{{urlRisco}}/api/v1/analises-risco/compras/{{idCompra}}", "host": ["{{urlRisco}}"], "path": ["api", "v1", "analises-risco", "compras", "{{idCompra}}"] } }
        },
        {
          "name": "Consultar pagamento",
          "event": [{ "listen": "test", "script": { "exec": [
            "const pagamento = pm.response.json();",
            "pm.test('Pagamento autorizado', () => { pm.response.to.have.status(200); pm.expect(pagamento.status).to.eql('AUTORIZADO'); });",
            "pm.collectionVariables.set('idPagamento', pagamento.idPagamento);",
            "pm.collectionVariables.set('idAutorizacao', pagamento.idAutorizacao);",
            "pm.collectionVariables.set('provedorPagamento', pagamento.provedor);"
          ], "type": "text/javascript" } }],
          "request": { "method": "GET", "header": [{ "key": "X-Empresa-Id", "value": "{{idEmpresa}}" }], "url": { "raw": "{{urlPagamento}}/api/v1/pagamentos/compras/{{idCompra}}", "host": ["{{urlPagamento}}"], "path": ["api", "v1", "pagamentos", "compras", "{{idCompra}}"] } }
        },
        {
          "name": "Consultar partidas dobradas",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Transacao contabil balanceada e parcelada', () => { const c = pm.response.json(); pm.expect(c.totalDebitos).to.eql(c.totalCreditos); pm.expect(c.lancamentos.length).to.eql(2); pm.expect(c.parcelas.length).to.eql(3); });"
          ], "type": "text/javascript" } }],
          "request": { "method": "GET", "header": [{ "key": "X-Empresa-Id", "value": "{{idEmpresa}}" }], "url": { "raw": "{{urlRazao}}/api/v1/transacoes-contabeis/compras/{{idCompra}}", "host": ["{{urlRazao}}"], "path": ["api", "v1", "transacoes-contabeis", "compras", "{{idCompra}}"] } }
        },
        {
          "name": "Liquidar primeira parcela",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Parcela liquidada com auditoria', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('LIQUIDADA'); });"
          ], "type": "text/javascript" } }],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "X-Empresa-Id", "value": "{{idEmpresa}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"referencia\": \"repasse-postman-001\"\n}" },
            "url": { "raw": "{{urlRazao}}/api/v1/transacoes-contabeis/compras/{{idCompra}}/parcelas/1/liquidacao", "host": ["{{urlRazao}}"], "path": ["api", "v1", "transacoes-contabeis", "compras", "{{idCompra}}", "parcelas", "1", "liquidacao"] }
          }
        },
        {
          "name": "Consultar notificacao",
          "event": [
            { "listen": "prerequest", "script": { "exec": [
              "const tentativa = Number(pm.collectionVariables.get('tentativasNotificacao') || 0);",
              "if (tentativa > 0) { setTimeout(() => {}, 500); }"
            ], "type": "text/javascript" } },
            { "listen": "test", "script": { "exec": [
              "pm.test('Consulta de notificacao respondida', () => pm.response.to.have.status(200));",
              "const notificacoes = pm.response.json();",
              "const tentativa = Number(pm.collectionVariables.get('tentativasNotificacao') || 0) + 1;",
              "if (notificacoes.length === 0 && tentativa < 20) {",
              "  pm.collectionVariables.set('tentativasNotificacao', String(tentativa));",
              "  pm.execution.setNextRequest(pm.info.requestName);",
              "} else {",
              "  pm.collectionVariables.unset('tentativasNotificacao');",
              "  pm.test('Notificacao enviada antes do limite', () => pm.expect(notificacoes.length).to.be.above(0));",
              "}"
            ], "type": "text/javascript" } }
          ],
          "request": { "method": "GET", "header": [{ "key": "X-Empresa-Id", "value": "{{idEmpresa}}" }], "url": { "raw": "{{urlNotificacao}}/api/v1/notificacoes/compras/{{idCompra}}", "host": ["{{urlNotificacao}}"], "path": ["api", "v1", "notificacoes", "compras", "{{idCompra}}"] } }
        },
        {
          "name": "Conciliar pagamento",
          "event": [
            { "listen": "prerequest", "script": { "exec": [
              "const agora = Date.now();",
              "pm.collectionVariables.set('identificadorExtratoConciliacao', 'extrato-' + pm.variables.replaceIn('{{$guid}}'));",
              "pm.collectionVariables.set('periodoInicioConciliacao', new Date(agora - 3600000).toISOString());",
              "pm.collectionVariables.set('periodoFimConciliacao', new Date(agora + 3600000).toISOString());",
              "pm.collectionVariables.set('ocorridoEmConciliacao', new Date(agora).toISOString());"
            ], "type": "text/javascript" } },
            { "listen": "test", "script": { "exec": [
              "const conciliacao = pm.response.json();",
              "pm.test('Conciliacao sem divergencias', () => { pm.response.to.have.status(200); pm.expect(conciliacao.divergencias).to.be.empty; pm.expect(conciliacao.reaproveitada).to.eql(false); });",
              "pm.collectionVariables.set('idConciliacao', conciliacao.idConciliacao);"
            ], "type": "text/javascript" } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "X-Empresa-Id", "value": "{{idEmpresa}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"provedor\": \"{{provedorPagamento}}\",\n  \"identificadorExtrato\": \"{{identificadorExtratoConciliacao}}\",\n  \"periodoInicio\": \"{{periodoInicioConciliacao}}\",\n  \"periodoFim\": \"{{periodoFimConciliacao}}\",\n  \"moeda\": \"BRL\",\n  \"registros\": [\n    {\n      \"idPagamento\": \"{{idPagamento}}\",\n      \"valor\": 199.70,\n      \"moeda\": \"BRL\",\n      \"status\": \"AUTORIZADO\",\n      \"idTransacaoProvedor\": \"{{idAutorizacao}}\",\n      \"ocorridoEm\": \"{{ocorridoEmConciliacao}}\"\n    }\n  ]\n}" },
            "url": { "raw": "{{urlPagamento}}/api/v1/conciliacoes", "host": ["{{urlPagamento}}"], "path": ["api", "v1", "conciliacoes"] }
          }
        },
        {
          "name": "Repetir o mesmo extrato",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Resultado idempotente foi reaproveitado', () => { const c = pm.response.json(); pm.response.to.have.status(200); pm.expect(c.reaproveitada).to.eql(true); pm.expect(c.idConciliacao).to.eql(pm.collectionVariables.get('idConciliacao')); });"
          ], "type": "text/javascript" } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "X-Empresa-Id", "value": "{{idEmpresa}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"provedor\": \"{{provedorPagamento}}\",\n  \"identificadorExtrato\": \"{{identificadorExtratoConciliacao}}\",\n  \"periodoInicio\": \"{{periodoInicioConciliacao}}\",\n  \"periodoFim\": \"{{periodoFimConciliacao}}\",\n  \"moeda\": \"BRL\",\n  \"registros\": [\n    {\n      \"idPagamento\": \"{{idPagamento}}\",\n      \"valor\": 199.70,\n      \"moeda\": \"BRL\",\n      \"status\": \"AUTORIZADO\",\n      \"idTransacaoProvedor\": \"{{idAutorizacao}}\",\n      \"ocorridoEm\": \"{{ocorridoEmConciliacao}}\"\n    }\n  ]\n}" },
            "url": { "raw": "{{urlPagamento}}/api/v1/conciliacoes", "host": ["{{urlPagamento}}"], "path": ["api", "v1", "conciliacoes"] }
          }
        },
        {
          "name": "Rejeitar extrato alterado",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Mesmo identificador com outro conteudo foi rejeitado', () => { pm.response.to.have.status(409); pm.expect(pm.response.json().codigo).to.eql('extrato-conciliacao-alterado'); });"
          ], "type": "text/javascript" } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "X-Empresa-Id", "value": "{{idEmpresa}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"provedor\": \"{{provedorPagamento}}\",\n  \"identificadorExtrato\": \"{{identificadorExtratoConciliacao}}\",\n  \"periodoInicio\": \"{{periodoInicioConciliacao}}\",\n  \"periodoFim\": \"{{periodoFimConciliacao}}\",\n  \"moeda\": \"BRL\",\n  \"registros\": [\n    {\n      \"idPagamento\": \"{{idPagamento}}\",\n      \"valor\": 199.71,\n      \"moeda\": \"BRL\",\n      \"status\": \"AUTORIZADO\",\n      \"idTransacaoProvedor\": \"{{idAutorizacao}}\",\n      \"ocorridoEm\": \"{{ocorridoEmConciliacao}}\"\n    }\n  ]\n}" },
            "url": { "raw": "{{urlPagamento}}/api/v1/conciliacoes", "host": ["{{urlPagamento}}"], "path": ["api", "v1", "conciliacoes"] }
          }
        },
        {
          "name": "Gerar divergencia controlada",
          "event": [
            { "listen": "prerequest", "script": { "exec": [
              "pm.collectionVariables.set('identificadorExtratoConciliacao', 'extrato-divergente-' + pm.variables.replaceIn('{{$guid}}'));"
            ], "type": "text/javascript" } },
            { "listen": "test", "script": { "exec": ["pm.test('Divergencia de valor foi identificada', () => { pm.response.to.have.status(200); const c = pm.response.json(); pm.expect(c.divergenciasEncontradas).to.eql(1); pm.expect(c.divergencias[0]).to.include('valor no provedor 199.71'); });"], "type": "text/javascript" } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "X-Empresa-Id", "value": "{{idEmpresa}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"provedor\": \"{{provedorPagamento}}\",\n  \"identificadorExtrato\": \"{{identificadorExtratoConciliacao}}\",\n  \"periodoInicio\": \"{{periodoInicioConciliacao}}\",\n  \"periodoFim\": \"{{periodoFimConciliacao}}\",\n  \"moeda\": \"BRL\",\n  \"registros\": [\n    {\n      \"idPagamento\": \"{{idPagamento}}\",\n      \"valor\": 199.71,\n      \"moeda\": \"BRL\",\n      \"status\": \"AUTORIZADO\",\n      \"idTransacaoProvedor\": \"{{idAutorizacao}}\",\n      \"ocorridoEm\": \"{{ocorridoEmConciliacao}}\"\n    }\n  ]\n}" },
            "url": { "raw": "{{urlPagamento}}/api/v1/conciliacoes", "host": ["{{urlPagamento}}"], "path": ["api", "v1", "conciliacoes"] }
          }
        },
        {
          "name": "Localizar divergencia aberta",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Divergencia aberta foi localizada', () => { pm.response.to.have.status(200); const pagina = pm.response.json(); const item = pagina.itens.find(i => i.idPagamento === pm.collectionVariables.get('idPagamento')); pm.expect(item).to.exist; pm.expect(item.tipo).to.eql('VALOR_DIVERGENTE'); pm.collectionVariables.set('idDivergencia', item.idDivergencia); });"
          ], "type": "text/javascript" } }],
