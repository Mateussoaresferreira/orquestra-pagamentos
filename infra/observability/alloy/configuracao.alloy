discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"
}

discovery.relabel "orquestrapay" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_orquestrapay_observavel"]
    regex         = "true"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    target_label = "aplicacao"
    replacement  = "orquestrapay"
  }
}

loki.source.docker "orquestrapay" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.relabel.orquestrapay.output
  forward_to    = [loki.write.local.receiver]
  relabel_rules = discovery.relabel.orquestrapay.rules
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
