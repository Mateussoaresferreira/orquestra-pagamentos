ambiente                         = "producao"
regiao                           = "us-east-1"
versao_kubernetes                = "1.33"
tipo_instancia_nos               = "t3.large"
nos_desejados                    = 3
nos_minimos                      = 3
nos_maximos                      = 9
classe_banco                     = "db.t4g.medium"
banco_multi_az                   = true
retencao_backup_banco_dias       = 35
classe_redis                     = "cache.t4g.small"
redis_multi_az                   = true
retencao_snapshot_redis_dias     = 7
proteger_exclusao                = true
retencao_logs_dias               = 365
api_kubernetes_publica           = false
cidrs_api_kubernetes             = []
cidrs_saida_https                = ["10.42.240.0/24"] # Substitua pelo CIDR privado do proxy ou firewall de saida.
email_alertas                    = "alertas@exemplo.com"

tags = {
  CentroCusto = "pagamentos"
  Responsavel = "plataforma"
}
